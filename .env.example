# Public values: safe in the frontend when RLS is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Guest photo AI: these two server settings are enough; no sign-in is needed.
# On Netlify, set these with Functions scope. Never use VITE_ for private keys.
GEMINI_API_KEY=
# Tested locally with gemini-3.5-flash-lite; choose a model your account supports.
AI_MODEL=

# Optional server settings for authenticated account deletion.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
